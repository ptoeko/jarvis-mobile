<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Нужен WebView для загрузки страниц. Приложение обращается только к
         собственным файлам внутри APK; все внешние адреса блокируются. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+: приложение должно объявить, что ищет камеру, иначе
         кнопка «Прикрепить» не предложит снять фото. Разрешение на камеру
         не нужно: снимает приложение камеры. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- allowBackup=false: рабочие заметки не копируются в облачную резервную
         копию Google без ведома пользователя. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Доступ к отдельным временным файлам: просмотр вложения, снимок камеры. -->
        <provider
            android:name=".FilesProvider"
            android:authorities="ru.jarvis.mobile.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
